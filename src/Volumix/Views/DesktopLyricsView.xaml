<UserControl
    x:Class="Volumix.Views.DesktopLyricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{x:Null}"
    FontFamily="Segoe UI Variable Display, Segoe UI"
    Foreground="White"
    TextOptions.TextFormattingMode="Ideal"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <!-- Вид работает в своём потоке, поэтому ресурсы приложения (тема WPF-UI) сюда тянуть нельзя:
         пустые стили обрывают поиск неявных стилей на этом уровне -->
    <UserControl.Resources>
        <Style TargetType="Grid" />
        <Style TargetType="Border" />
        <Style TargetType="Image" />
        <Style TargetType="TextBlock" />
        <Style TargetType="StackPanel" />
        <Style TargetType="Rectangle" />
        <Style TargetType="Viewbox" />
        <Style TargetType="Canvas" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>

    <Grid Background="#101014" ClipToBounds="True">
        <!-- Размытая обложка во весь экран. Кэш, чтобы размытие не пересчитывалось при каждой анимации текста -->
        <Grid CacheMode="BitmapCache">
            <Image x:Name="Backdrop" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect Radius="110" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Image x:Name="BackdropNext" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect Radius="110" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Rectangle Fill="#94000000" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#59000000" />
                        <GradientStop Offset="0.45" Color="#00000000" />
                        <GradientStop Offset="1" Color="#4D000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Макет нарисован для 1920×1080 и масштабируется под экран. Слева место под значки рабочего стола -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Page" Width="1920" Height="1080">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,40">
                    <!-- Высоту под широкую обложку (кадр из клипа) ставит код -->
                    <Grid x:Name="CoverBox" Width="440" Height="440" HorizontalAlignment="Left">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="70" ShadowDepth="18" Direction="270" Opacity="0.55" />
                        </Grid.Effect>
                        <Border CornerRadius="18" Background="#26FFFFFF" />
                        <TextBlock x:Name="CoverGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="120"
                                   Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border CornerRadius="18">
                            <Border.Background>
                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="TitleText" Margin="0,40,0,0" FontSize="46" FontWeight="Bold" LineHeight="54"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="166" />
                    <TextBlock x:Name="ArtistText" Margin="0,8,0,0" FontSize="28" FontWeight="SemiBold" Opacity="0.78"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AlbumText" Margin="0,4,0,0" FontSize="22" Opacity="0.5" TextTrimming="CharacterEllipsis" />

                    <Grid Margin="0,34,0,0" Width="440" HorizontalAlignment="Left">
                        <Border Height="6" CornerRadius="3" Background="#3DFFFFFF" ClipToBounds="True">
                            <Border CornerRadius="3" Background="#F2FFFFFF" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                    <Grid Margin="0,12,0,0" Width="440" HorizontalAlignment="Left" TextElement.FontSize="20">
                        <TextBlock x:Name="ElapsedText" Opacity="0.6" HorizontalAlignment="Left" />
                        <TextBlock x:Name="PauseGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE769;" FontSize="22"
                                   Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="DurationText" Opacity="0.6" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Текст песни: текущая строка стоит на одном уровне, остальные плавно уезжают -->
                <Grid Grid.Column="3" Margin="0,80">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="Badge" FontSize="18" FontWeight="SemiBold" Opacity="0.45" Margin="0,0,0,10"
                               Visibility="Collapsed" Text="ТЕКСТ БЕЗ СИНХРОНИЗАЦИИ" />
                    <!-- Затухание по краям в координатах области текста (высоту ставит код), иначе оно уехало бы со строками -->
                    <Canvas x:Name="LinesCanvas" Grid.Row="1" ClipToBounds="True">
                        <Canvas.OpacityMask>
                            <LinearGradientBrush x:Name="LinesMask" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,920">
                                <GradientStop Offset="0" Color="Transparent" />
                                <GradientStop Offset="0.16" Color="Black" />
                                <GradientStop Offset="0.8" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Canvas.OpacityMask>
                        <StackPanel x:Name="Lines" Width="{Binding ActualWidth, ElementName=LinesCanvas}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="LinesShift" />
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>
                    <!-- Клип без текста: вместо текста — обложка крупно. Размер под её пропорции ставит код -->
                    <Grid x:Name="BigCover" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="80" ShadowDepth="20" Direction="270" Opacity="0.6" />
                        </Grid.Effect>
                        <Border CornerRadius="22">
                            <Border.Background>
                                <ImageBrush x:Name="BigCoverBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="Status" Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" FontSize="44" FontWeight="SemiBold" Opacity="0.55" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusHint" FontSize="20" Opacity="0.4" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="30" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
