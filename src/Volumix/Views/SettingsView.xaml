<UserControl
    x:Class="Volumix.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Volumix.ViewModels">
    <UserControl.Resources>
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource SectionHeader}" Text="Запуск" Margin="2,0,0,8" />

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE7E8;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Запускать вместе с Windows" />
                    <TextBlock Style="{StaticResource Caption}" Text="Volumix будет тихо стартовать в области уведомлений" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding Autostart}" OnContent="Вкл." OffContent="Выкл." />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE73F;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Сворачивать в трей при закрытии" />
                    <TextBlock Style="{StaticResource Caption}" Text="Крестик прячет окно, горячие клавиши продолжают работать" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding CloseToTray}" OnContent="Вкл." OffContent="Выкл." />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE8D6;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Источник песни" />
                    <TextBlock Style="{StaticResource Caption}" Text="Браузер опознаётся по заголовку вкладки: Яндекс Музыка или YouTube. Если песня играет, а источника не видно — выберите его вручную" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="2" Width="280" ItemsSource="{x:Static vm:SettingsViewModel.Sources}"
                          DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding Source}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE8B9;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Островок с плеером" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Вверху экрана — что играет, сколько прошло и кнопки «назад», «пауза», «вперёд». Любой плеер: музыка, ролики, фильмы. Полоса перематывает, колёсико мыши меняет громкость плеера. Островок перетаскивается куда угодно, в том числе на панель задач, и растягивается за края. Во время игр и в полноэкранных окнах островок прячется" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding MediaIsland}" OnContent="Вкл." OffContent="Выкл." />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE769;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Островок на паузе" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Через сколько прятать островок, когда плеер на паузе. Вернётся, как только музыка или видео заиграют снова. Если не скрывать, островок с паузой висит, пока плеер или вкладка открыты" />
                </StackPanel>
                <ComboBox Grid.Column="2" Width="200" ItemsSource="{x:Static vm:SettingsViewModel.IslandPauseHides}"
                          DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding IslandPauseHide}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE70E;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Прятать островок в край экрана" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="От островка остаётся тонкая полоска у края экрана, а сам он выезжает, когда курсор упирается в край напротив него. Спрятать можно и жестом — задвинуть островок за край экрана, достать — потянуть от края" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IslandDocked}" OnContent="Вкл." OffContent="Выкл." />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE916;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Автоскрытие островка" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Островок показывается при смене трека, паузе и продолжении, а потом сам уезжает в край экрана. Достать — подвести курсор к краю" />
                </StackPanel>
                <ComboBox Grid.Column="2" Width="200" ItemsSource="{x:Static vm:SettingsViewModel.IslandAutoHides}"
                          DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding IslandAutoHide}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE8D6;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Песня и текст на рабочем столе" />
                    <TextBlock Style="{StaticResource Caption}" Text="Пока играет песня, вместо обоев — обложка и текст, строки подсвечиваются под музыку. Работает со Spotify и Яндекс Музыкой (в том числе в браузере). Тексты берутся с lrclib.net, свои можно положить в папку файлами .lrc" TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="2" Margin="0,0,12,0" Content="Папка текстов" Click="OpenLyricsFolder_Click" />
                <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding DesktopLyrics}" OnContent="Вкл." OffContent="Выкл." />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE7F4;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Мониторы" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="На каких экранах показывать песню вместо обоев. Монитор, подключённый позже, подхватывается сам" />
                </StackPanel>
                <ComboBox Grid.Column="2" Width="280" ItemsSource="{Binding Screens}"
                          DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding DesktopScreen}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE768;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Кнопки на рабочем столе" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="«Назад», «Играть / пауза» и «Вперёд» под полосой прогресса, как в Spotify. Нажимаются прямо на рабочем столе, если над ними нет окон" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding DesktopControls}" OnContent="Вкл." OffContent="Выкл." />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE8E4;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Скорость бегущей строки" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Как быстро уезжает длинное название песни на рабочем столе. По умолчанию 22" />
                </StackPanel>
                <Slider Grid.Column="2" Width="170" Minimum="5" Maximum="100" TickFrequency="1"
                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                        Value="{Binding MarqueeSpeed}" />
                <TextBlock Grid.Column="3" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding MarqueeSpeed}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE9D9;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Кадров в секунду у бегущей строки" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Больше — плавнее, но выше частоты монитора не бывает. Кадры рисуются, только пока строка едет. По умолчанию 60" />
                </StackPanel>
                <Slider Grid.Column="2" Width="170" Minimum="15" Maximum="240" TickFrequency="5"
                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                        Value="{Binding MarqueeFps}" />
                <TextBlock Grid.Column="3" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding MarqueeFps}" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Громкость" />

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE995;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Шаг изменения громкости" />
                    <TextBlock Style="{StaticResource Caption}" Text="Для горячих клавиш и колёсика мыши" />
                </StackPanel>
                <Slider Grid.Column="2" Width="170" Minimum="1" Maximum="25" TickFrequency="1"
                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                        Value="{Binding VolumeStep}" />
                <TextBlock Grid.Column="3" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding VolumeStep, StringFormat={}{0}%}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE7F4;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Всплывающий индикатор" />
                    <TextBlock Style="{StaticResource Caption}" Text="Показывать громкость внизу экрана при нажатии горячих клавиш" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding ShowOsd}" OnContent="Вкл." OffContent="Выкл." />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Оформление" />

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE790;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Тема" />
                    <TextBlock Style="{StaticResource Caption}" Text="Цвет акцента берётся из настроек Windows" />
                </StackPanel>
                <ComboBox Grid.Column="2" Width="180" ItemsSource="{x:Static vm:SettingsViewModel.Themes}"
                          DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="О программе" />

        <Border Style="{StaticResource Card}">
            <Grid Style="{StaticResource RowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="28" Height="28" HorizontalAlignment="Left" Source="pack://application:,,,/Assets/app.ico" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Volumix" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Version}" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Папка настроек" Click="OpenSettingsFolder_Click" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
