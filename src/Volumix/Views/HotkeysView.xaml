<UserControl
    x:Class="Volumix.Views.HotkeysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Volumix.ViewModels">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left" Text="&#xE765;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Body}" Text="Глобальные сочетания клавиш" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Работают везде, даже когда окно скрыто. «Активное окно» меняет громкость программы, которая сейчас на переднем плане." />
                </StackPanel>
                <ui:Button Grid.Column="2" Appearance="Primary" Content="Добавить" Command="{Binding AddHotkeyCommand}" />
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Hotkeys}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HotkeyBindingViewModel}">
                    <Border Style="{StaticResource Card}" Padding="14,12,8,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel>
                                <ui:TextBox Width="210" Margin="0,0,8,4" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                            ClearButtonEnabled="False" Cursor="Hand"
                                            PlaceholderText="Нажмите сочетание…"
                                            Text="{Binding GestureText, Mode=OneWay}"
                                            ToolTip="Щёлкните и нажмите сочетание. Backspace — очистить, Esc — отмена."
                                            PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                            GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                            LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                                <ComboBox Width="200" Margin="0,0,8,4"
                                          ItemsSource="{x:Static vm:HotkeyBindingViewModel.Actions}"
                                          DisplayMemberPath="Title" SelectedValuePath="Value"
                                          SelectedValue="{Binding Action}" />
                                <ComboBox Width="180" Margin="0,0,8,4"
                                          ItemsSource="{x:Static vm:HotkeyBindingViewModel.Targets}"
                                          DisplayMemberPath="Title" SelectedValuePath="Value"
                                          SelectedValue="{Binding Target}"
                                          Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox Width="180" Margin="0,0,8,4" IsEditable="True"
                                          ItemsSource="{Binding DataContext.KnownApps, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Text="{Binding App, UpdateSourceTrigger=LostFocus}"
                                          DropDownOpened="AppCombo_DropDownOpened"
                                          ToolTip="Имя exe без расширения, например chrome или spotify"
                                          Visibility="{Binding HasApp, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>

                            <ui:Button Grid.Column="1" Appearance="Transparent" Width="36" Height="34" Padding="0"
                                       VerticalAlignment="Top" BorderThickness="0" ToolTip="Удалить"
                                       Command="{Binding RemoveCommand}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                            </ui:Button>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,2,0,0"
                                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE7BA;"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Это сочетание уже занято другой программой — выберите другое." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
