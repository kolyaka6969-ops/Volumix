<UserControl
    x:Class="Volumix.Views.MixerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="DeviceHeader" Style="{StaticResource SectionHeader}" Text="Устройство вывода" Margin="2,0,0,8" />
        <Border Style="{StaticResource Card}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Left"
                           Text="{Binding SelectedDevice.Glyph, FallbackValue=&#xE7F5;}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                          ToolTip="Выбранное устройство станет устройством вывода по умолчанию" />
            </Grid>
        </Border>

        <ContentControl Content="{Binding Master}" ContentTemplate="{StaticResource ChannelTemplate}"
                        Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="Приложения" />
        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource ChannelTemplate}" />

        <Border Style="{StaticResource Card}" Padding="16,20"
                Visibility="{Binding Apps.Count, Converter={StaticResource InvertBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" FontSize="28" Text="&#xE8D6;" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center"
                           Text="Сейчас ни одно приложение не воспроизводит звук" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
