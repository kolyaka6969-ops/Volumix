<Window
    x:Class="Volumix.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Volumix"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="TrayItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Width="246" Background="#202022" CornerRadius="10" BorderBrush="#2E2E32" BorderThickness="1" Padding="12,12,12,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45" />
            </Border.Effect>
            <StackPanel>
                <!-- Заголовок в точном стиле Orbit -->
                <Grid Margin="2,2,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Иконка в градиентном скругленном квадрате -->
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0" />
                                <GradientStop Color="#1D4ED8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Название и статус работы в фоне -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Volumix" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Работает в фоне" FontSize="12" Foreground="#9E9EA4" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Тонкий разделитель под заголовком -->
                <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,6" />

                <!-- Пункты меню -->
                <Button Style="{StaticResource TrayItemButton}" Click="Mixer_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Микшер громкости" FontSize="13.5" Foreground="#FFFFFF"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Button>

                <Button Style="{StaticResource TrayItemButton}" Click="Lyrics_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Текст на рабочем столе" FontSize="13.5" Foreground="#FFFFFF"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock x:Name="LyricsCheck" Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                   FontSize="14" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,2,0" />
                    </Grid>
                </Button>

                <Button Style="{StaticResource TrayItemButton}" Click="Island_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Островок с плеером" FontSize="13.5" Foreground="#FFFFFF"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock x:Name="IslandCheck" Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                   FontSize="14" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,2,0" />
                    </Grid>
                </Button>

                <Button Style="{StaticResource TrayItemButton}" Click="Hotkeys_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Горячие клавиши" FontSize="13.5" Foreground="#FFFFFF"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Button>

                <Button Style="{StaticResource TrayItemButton}" Click="Settings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Настройки" FontSize="13.5" Foreground="#FFFFFF"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Button>

                <!-- Разделитель перед выходом -->
                <Border Height="1" Background="#1FFFFFFF" Margin="0,6,0,6" />

                <!-- Выход из приложения -->
                <Button Style="{StaticResource TrayItemButton}" Click="Exit_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Выйти из Volumix" FontSize="13.5" Foreground="#FFFFFF"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>