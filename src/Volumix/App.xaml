<Application
    x:Class="Volumix.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Volumix.ViewModels"
    xmlns:views="clr-namespace:Volumix.Views"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

            <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <views:BoolToVisibilityConverter x:Key="InvertBoolToVisibility" Invert="True" />

            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,18,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- Строка канала громкости: общая громкость и каждое приложение -->
            <DataTemplate x:Key="ChannelTemplate" DataType="{x:Type vm:ChannelViewModel}">
                <Border Style="{StaticResource Card}" Padding="14,10,8,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.RowSpan="2" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Glyph}" FontSize="22" Text="{Binding FallbackGlyph}"
                                       Visibility="{Binding HasIcon, Converter={StaticResource InvertBoolToVisibility}}" />
                        </Grid>

                        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Body}" Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" Margin="2,0,8,0" ToolTip="{Binding Name}" />

                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    Value="{Binding Volume, Mode=TwoWay}" Margin="0,4,0,0" />
                            <!-- Индикатор уровня сигнала -->
                            <Border Height="3" CornerRadius="1.5" Margin="10,1,10,0" ClipToBounds="True"
                                    Background="{DynamicResource ControlStrongStrokeColorDisabledBrush}">
                                <Border CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Peak}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Body}" Text="{Binding Volume}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <ui:Button Grid.Row="1" Grid.Column="3" Appearance="Transparent" Width="40" Height="34" Padding="0"
                                   Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="0"
                                   Command="{Binding ToggleMuteCommand}" ToolTip="Вкл/выкл звук">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" />
                        </ui:Button>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                        <Setter TargetName="VolumeSlider" Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
