<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <!-- WPF и WinForms вместе дают конфликты имён в неявных using-ах -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>Volumix</AssemblyName>
    <RootNamespace>Volumix</RootNamespace>
    <Product>Volumix</Product>
    <Version>1.6.7</Version>
    <Description>Микшер громкости приложений для Windows 10 и 11</Description>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>

  <!-- Сборка для Windows 10: build.ps1 -Win10 (островок не вшивается в панель задач и на Windows 11) -->
  <PropertyGroup Condition="'$(Win10Build)' == 'true'">
    <DefineConstants>$(DefineConstants);WIN10</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Нативные библиотеки WPF лежат рядом с exe. Внутри exe они при каждой новой версии распаковывались
         в %TEMP%\.net\Volumix — ещё десятки МБ на диске на каждую версию, и никто их не удалял. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Без сжатия: сжатые сборки .NET при запуске распаковываются в память целиком (+80 МБ private, +160 МБ рабочего
         набора в трее), а несжатые отображаются из файла. Установщик всё равно сжимает exe LZMA. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Интерфейс только на русском: переводы сообщений .NET на другие 12 языков не нужны (−16 МБ до сжатия) -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <InternalsVisibleTo Include="Volumix.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

</Project>
